{
  "expo": {
    "name": "Placeboo",
    "slug": "placeboo-converter",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "primaryColor": "#4F46E5",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#4F46E5"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.placeboo.converter",
      "infoPlist": {
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true,
        "NSDocumentsFolderUsageDescription": "Placeboo memerlukan izin untuk membaca dan mengonversi berkas dokumen PDF Anda.",
        "NSPhotoLibraryUsageDescription": "Placeboo memerlukan izin galeri untuk memilih foto dan membuat berkas PDF.",
        "NSPhotoLibraryAddUsageDescription": "Placeboo memerlukan izin galeri untuk menyimpan hasil gambar dokumen ke galeri foto Anda."
      }
    },
    "android": {
      "package": "com.placeboo.converter",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#4F46E5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "READ_MEDIA_AUDIO",
        "MANAGE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [],
    "extra": {
      "eas": {
        "projectId": "29dd23b1-2b13-43af-80b4-ffd4ef6bc8be"
      }
    }
  }
}
